# Signs session cookies for the login system. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Seeds the first super_admin account on startup (only if aiwebmaster_users is
# empty — no public signup route, this is a one-time bootstrap).
AIWEBMASTER_ADMIN_EMAIL=
AIWEBMASTER_ADMIN_PASSWORD=

# Shared secret AIwebmaster sends as `x-service-token` when calling CMS
# content/nav endpoints (must match CMS_SERVICE_TOKEN set on the cms service).
CMS_SERVICE_TOKEN=

AI_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

CMS_URL=http://cms:3003
REPO_PATH=/repo

API_DATABASE_URL=postgresql://tbg:tbg_dev@postgres:5432/tbg_api
CMS_DATABASE_URL=postgresql://tbg:tbg_dev@postgres:5432/tbg_cms

# Auth0 ("Sign in with Auth0") — optional, alternate login for an EXISTING
# aiwebmaster_users row (not self-service signup). Create an Auth0
# "Regular Web Application", add AUTH0_REDIRECT_URI to its Allowed Callback
# URLs, and set these three:
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=http://localhost:8110/api/auth/auth0/callback

# Path (inside this container) to a dedicated deploy-only SSH private key,
# distinct from your personal key. Generate one, add its public half as a
# GitHub deploy key on this repo (write access if push should work), then
# bind-mount it read-only into the aiwebmaster container and point
# GIT_SSH_COMMAND at it (see docker-compose.yml).
# AIWEBMASTER_DEPLOY_SSH_KEY_PATH=/run/secrets/aiwebmaster_deploy_key
